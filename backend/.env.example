PROJECT_NAME=ShopMind AI
VERSION=1.0.0
API_PREFIX=/api

# MongoDB
MONGODB_URL=mongodb://localhost:27017
DATABASE_NAME=ai_shopping_assistant

# Authentication (replace with a long random secret)
JWT_SECRET=replace-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Optional AI query interpretation and Google Shopping retrieval
GEMINI_API_KEY=
SERPAPI_KEY=

# Frontend origins
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
